<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FUPlayer.Core</RootNamespace>
    <AssemblyName>FUPlayer.Core</AssemblyName>
  </PropertyGroup>

  <!--
    The real-time DSP engine cannot keep up with high DSD rates when unoptimised, so Debug builds of this
    library are optimised too. Build with -p:FuPlayerDebugDsp=true to step through DSP code without optimisation.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(FuPlayerDebugDsp)' != 'true'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FUPlayer.Core.Tests" />
  </ItemGroup>

  <!-- The FFmpeg build script, which "Download and build FFmpeg" runs from a copy of its own. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\build\ffmpeg\build-ffmpeg-lgpl.sh" LogicalName="FUPlayer.Core.build-ffmpeg-lgpl.sh" />
  </ItemGroup>

</Project>
