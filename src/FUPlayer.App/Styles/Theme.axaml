<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:FUPlayer.App.Controls">
  <!-- FUPlayer dark theme. Colours are mirrored in Controls/Palette.cs for the custom-drawn controls. -->
  <Styles.Resources>
    <ResourceDictionary>
      <Color x:Key="SystemAccentColor">#3FD3C1</Color>
      <Color x:Key="SystemAccentColorDark1">#33BCAB</Color>
      <Color x:Key="SystemAccentColorDark2">#279E90</Color>
      <Color x:Key="SystemAccentColorDark3">#1C7F74</Color>
      <Color x:Key="SystemAccentColorLight1">#5FDCCD</Color>
      <Color x:Key="SystemAccentColorLight2">#83E5D9</Color>
      <Color x:Key="SystemAccentColorLight3">#A8EEE6</Color>

      <SolidColorBrush x:Key="WindowBrush" Color="#0C0F14" />
      <SolidColorBrush x:Key="RailBrush" Color="#0A0D11" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#141920" />
      <SolidColorBrush x:Key="SurfaceHighBrush" Color="#1B222B" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#232B35" />
      <SolidColorBrush x:Key="LineBrush" Color="#27303B" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EDF3" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#98A5B3" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#5F6B78" />
      <SolidColorBrush x:Key="AccentBrush" Color="#3FD3C1" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#5FDCCD" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#33BCAB" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#223FD3C1" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#04201C" />
      <SolidColorBrush x:Key="DsdBrush" Color="#9B87FF" />
      <SolidColorBrush x:Key="DsdSoftBrush" Color="#269B87FF" />
      <SolidColorBrush x:Key="WarningBrush" Color="#F4C44F" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#24F4C44F" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FF5A6A" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#26FF5A6A" />
      <SolidColorBrush x:Key="GoodBrush" Color="#62D892" />
      <SolidColorBrush x:Key="SelectionBrush" Color="#1D3337" />

      <FontFamily x:Key="AppFont">fonts:Inter#Inter, $Default</FontFamily>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.numeric">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.dsd">
    <Setter Property="Foreground" Value="{StaticResource DsdBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource LineBrush}" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.badge.accent">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.badge.accent TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Border.badge.dsd">
    <Setter Property="Background" Value="{StaticResource DsdSoftBrush}" />
  </Style>
  <Style Selector="Border.badge.dsd TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DsdBrush}" />
  </Style>
  <Style Selector="Border.badge.warning">
    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
  </Style>
  <Style Selector="Border.badge.warning TextBlock">
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="Border.badge.danger">
    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
  </Style>
  <Style Selector="Border.badge.danger TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
  </Style>
  <Style Selector="Button.icon.on">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.icon.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>

  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <!-- A button asking to be pressed, without shouting: the library's "files changed" update. -->
  <Style Selector="Button.attention /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="Button.attention:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
  </Style>

  <Style Selector="Button.play">
    <Setter Property="Width" Value="50" />
    <Setter Property="Height" Value="50" />
    <Setter Property="CornerRadius" Value="25" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.play:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>

  <!-- Navigation rail -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="10,3" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Segmented choice (a horizontal single-selection ListBox) -->
  <Style Selector="ListBox.segmented">
    <Setter Property="AutoScrollToSelectedItem" Value="False" />
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem">
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>

  <!-- Tables (queue, track lists) and card lists -->
  <Style Selector="ListBox.table">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
  </Style>

  <Style Selector="ListBox.cards">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Row, tile and chip buttons -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.tile">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.tile:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tile Button.overlay">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.tile:pointerover Button.overlay">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.tile:pointerover Border.cover">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.chip.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
  </Style>

  <!-- Setting row -->
  <Style Selector="controls|SettingRow">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" MinHeight="46">
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,6,24,6">
            <TextBlock Text="{TemplateBinding Title}" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{TemplateBinding Description}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinWidth" Value="200" />
  </Style>
  <Style Selector="ScrollViewer.page">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!--
    Keyboard focus. The ring is drawn as a shadow rather than a border so that showing it never changes a
    control's size, and :focus-visible keeps it to keyboard navigation: clicking does not light anything up.
    Every control the app can reach with Tab or the arrow keys is covered, because a custom template that
    replaces the Fluent one loses the theme's own focus adorner with it.
  -->
  <Style Selector=":is(Button):focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 0 2 #3FD3C1" />
  </Style>
  <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 0 2 #3FD3C1" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#Background">
    <Setter Property="BoxShadow" Value="0 0 0 2 #3FD3C1" />
  </Style>
  <Style Selector="CheckBox:focus-visible /template/ Border#NormalRectangle">
    <Setter Property="BoxShadow" Value="0 0 0 2 #3FD3C1" />
  </Style>
  <Style Selector="ToggleSwitch:focus-visible /template/ Border#SwitchKnobBounds">
    <Setter Property="BoxShadow" Value="0 0 0 2 #3FD3C1" />
  </Style>
  <Style Selector="TabItem:focus-visible /template/ Border#PART_LayoutRoot">
    <Setter Property="BoxShadow" Value="0 0 0 2 #3FD3C1" />
  </Style>
</Styles>
