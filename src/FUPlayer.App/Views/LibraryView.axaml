<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FUPlayer.App.ViewModels"
             xmlns:controls="using:FUPlayer.App.Controls"
             x:Class="FUPlayer.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <Grid ColumnDefinitions="*,Auto">
    <Grid RowDefinitions="Auto,Auto,*" Margin="28,22,16,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="Library" />
          <TextBlock Classes="secondary" Text="{Binding Status}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ListBox Classes="segmented" ItemsSource="{Binding BrowseChoices}" SelectedItem="{Binding SelectedBrowse}" VerticalAlignment="Center"
                   ToolTip.Tip="List the albums on their own, or beside their artists or genres" />
          <Panel Width="320">
            <TextBox Text="{Binding SearchText}" PlaceholderText="Search  ·  e.g. +artist:bach album:cello" CornerRadius="18" Padding="36,7,12,7" VerticalContentAlignment="Center" />
            <controls:LineIcon Data="{x:Static controls:Icons.Search}" Width="16" Height="16" HorizontalAlignment="Left" Margin="13,0,0,0"
                               Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" />
          </Panel>
          <Button Classes="subtle" Command="{Binding AddFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:LineIcon Data="{x:Static controls:Icons.Add}" Width="16" Height="16" />
              <TextBlock Text="Add folder" />
            </StackPanel>
          </Button>
          <Button Classes="subtle" Command="{Binding RefreshCommand}" IsVisible="{Binding !IsScanning}"
                  Classes.attention="{Binding HasPendingChanges}"
                  ToolTip.Tip="Look for new and changed files">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:LineIcon Data="{x:Static controls:Icons.Refresh}" Width="16" Height="16" />
              <TextBlock Text="Update" IsVisible="{Binding !HasPendingChanges}" />
              <TextBlock Text="Files changed, update" IsVisible="{Binding HasPendingChanges}" />
            </StackPanel>
          </Button>
          <Button Classes="subtle" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:LineIcon Data="{x:Static controls:Icons.Stop}" IsFilled="True" Width="14" Height="14" />
              <TextBlock Text="Stop scan" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" IsVisible="{Binding HasFolders}">
      <CheckBox Grid.Column="1" IsChecked="{Binding WatchFolders}" VerticalAlignment="Top" Margin="12,12,0,0" Content="Watch for changes"
                ToolTip.Tip="Notice files added, changed or removed under these folders, and update once they have settled" />
      <ItemsControl ItemsSource="{Binding Folders}" Margin="0,14,0,4">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FolderItem">
            <Border Classes="badge" Margin="0,0,8,8" Padding="10,2,3,2">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:LineIcon Data="{x:Static controls:Icons.Folder}" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Path}" FontWeight="Normal" MaxWidth="380" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button Classes="icon" Padding="5" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove this folder from the library">
                  <controls:LineIcon Data="{x:Static controls:Icons.Close}" Width="10" Height="10" />
                </Button>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Grid>

      <Panel Grid.Row="2">
        <Grid ColumnDefinitions="Auto,*">
        <Grid RowDefinitions="Auto,*" Width="216" Margin="0,8,18,0" IsVisible="{Binding IsBrowsingGroups}">
          <TextBlock Classes="eyebrow" Text="{Binding SelectedBrowse.Label}" Margin="10,0,0,6" />
          <ListBox Grid.Row="1" Classes="table" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LibraryGroup">
                <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Summary}">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="muted small numeric" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <ScrollViewer Grid.Column="1" x:Name="AlbumScroller" HorizontalScrollBarVisibility="Disabled" Padding="0,8,12,0">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlbumRowViewModel">
                <ItemsControl ItemsSource="{Binding Albums}" Margin="0,0,0,22">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="20" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlbumViewModel">
                      <Button Classes="tile" Width="180" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Folder}">
                        <Button.ContextFlyout>
                          <MenuFlyout>
                            <MenuItem Header="Play album" Command="{Binding PlayCommand}" />
                            <MenuItem Header="Play next" Command="{Binding PlayNextCommand}" />
                            <MenuItem Header="Add to queue" Command="{Binding EnqueueCommand}" />
                            <Separator />
                            <MenuItem Header="Show album" Command="{Binding OpenCommand}" />
                            <MenuItem Header="More by this artist" Command="{Binding ShowArtistCommand}" />
                            <MenuItem Header="More of this genre" Command="{Binding ShowGenreCommand}"
                                      IsEnabled="{Binding Genre, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Separator />
                            <MenuItem Header="Show in folder" Command="{Binding ShowInFolderCommand}" />
                          </MenuFlyout>
                        </Button.ContextFlyout>
                        <StackPanel Spacing="2">
                          <Panel Width="180" Height="180">
                            <Border Classes="cover" CornerRadius="10" ClipToBounds="True" Background="{Binding PlaceholderBrush}" BorderThickness="2" BorderBrush="Transparent">
                              <Panel>
                                <TextBlock Text="{Binding Initials}" FontSize="42" FontWeight="Bold" Foreground="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                              </Panel>
                            </Border>
                            <Border Classes="badge dsd" IsVisible="{Binding IsDsd}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#CC1A1530">
                              <TextBlock Text="DSD" FontSize="10" />
                            </Border>
                            <Border Classes="badge accent" IsVisible="{Binding IsHiRes}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#CC0E2724">
                              <TextBlock Text="HI-RES" FontSize="10" />
                            </Border>
                            <Button Classes="play overlay" Width="42" Height="42" CornerRadius="21" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                    Command="{Binding PlayCommand}" ToolTip.Tip="Play album">
                              <controls:LineIcon Data="{x:Static controls:Icons.Play}" IsFilled="True" Width="18" Height="18" />
                            </Button>
                          </Panel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Margin="2,8,2,0" />
                          <TextBlock Text="{Binding Artist}" Classes="secondary small" TextTrimming="CharacterEllipsis" Margin="2,0" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        </Grid>

        <Border Classes="card" IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Padding="36,30">
          <StackPanel Spacing="12">
            <controls:LineIcon Data="{x:Static controls:Icons.Library}" Width="48" Height="48" StrokeThickness="1.3" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
            <TextBlock Classes="h2" Text="Build your library" HorizontalAlignment="Center" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Point FUPlayer at the folders that hold your music. Each folder becomes an album; tags and covers are read in the background and cached." />
            <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding AddFolderCommand}" Content="Add a music folder" />
          </StackPanel>
        </Border>
      </Panel>
    </Grid>

    <Border Grid.Column="1" Width="420" IsVisible="{Binding IsDetailOpen}" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="20,14,12,0">
          <TextBlock Classes="eyebrow" Text="ALBUM" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="icon" Padding="7" Command="{Binding CloseDetailCommand}" ToolTip.Tip="Close">
            <controls:LineIcon Data="{x:Static controls:Icons.Close}" Width="14" Height="14" />
          </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <ContentControl Content="{Binding SelectedAlbum}" Margin="20,6,20,20">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:AlbumViewModel">
                <StackPanel Spacing="4">
                  <Border Width="300" Height="300" CornerRadius="12" ClipToBounds="True" Background="{Binding PlaceholderBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Panel>
                      <TextBlock Text="{Binding Initials}" FontSize="64" FontWeight="Bold" Foreground="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Source="{Binding LargeCover}" Stretch="UniformToFill" />
                    </Panel>
                  </Border>
                  <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
                  <TextBlock Classes="secondary" Text="{Binding Artist}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Border Classes="badge" Classes.dsd="{Binding IsDsd}" IsVisible="{Binding Format, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding Format}" />
                    </Border>
                    <TextBlock Classes="muted small" Text="{Binding Details}" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,10">
                    <Button Classes="primary" Command="{Binding PlayCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:LineIcon Data="{x:Static controls:Icons.Play}" IsFilled="True" Width="14" Height="14" />
                        <TextBlock Text="Play" />
                      </StackPanel>
                    </Button>
                    <Button Classes="subtle" Command="{Binding PlayNextCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:LineIcon Data="{x:Static controls:Icons.PlayNext}" Width="16" Height="16" />
                        <TextBlock Text="Play next" />
                      </StackPanel>
                    </Button>
                    <Button Classes="subtle" Command="{Binding EnqueueCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:LineIcon Data="{x:Static controls:Icons.Add}" Width="16" Height="16" />
                        <TextBlock Text="Queue" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Tracks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TrackViewModel">
                        <Button Classes="row" Command="{Binding PlayCommand}" Padding="8,6" ToolTip.Tip="Play from this track">
                          <Button.ContextFlyout>
                            <MenuFlyout>
                              <MenuItem Header="Play album from here" Command="{Binding PlayCommand}" />
                              <MenuItem Header="Play this track only" Command="{Binding PlayOnlyCommand}" />
                              <MenuItem Header="Play next" Command="{Binding PlayNextCommand}" />
                              <MenuItem Header="Add to queue" Command="{Binding EnqueueCommand}" />
                              <Separator />
                              <MenuItem Header="Show in folder" Command="{Binding ShowInFolderCommand}" />
                            </MenuFlyout>
                          </Button.ContextFlyout>
                          <Grid ColumnDefinitions="36,*,Auto,Auto">
                            <TextBlock Text="{Binding Number}" Classes="muted small numeric" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Subtitle}" Classes="muted small" IsVisible="{Binding HasSubtitle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Duration}" Classes="secondary small numeric" VerticalAlignment="Center" Margin="10,0" />
                            <Button Grid.Column="3" Classes="icon" Padding="5" Command="{Binding EnqueueCommand}" ToolTip.Tip="Add to queue">
                              <controls:LineIcon Data="{x:Static controls:Icons.Add}" Width="14" Height="14" />
                            </Button>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
