<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FUPlayer.App.ViewModels"
             xmlns:controls="using:FUPlayer.App.Controls"
             xmlns:views="using:FUPlayer.App.Views"
             x:Class="FUPlayer.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer Classes="page">
    <StackPanel Margin="28,22,28,28" Spacing="18" MaxWidth="1000" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Settings" />
        <TextBlock Classes="secondary" Text="Playback behaviour, processing resources and information about this build." />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="10" DataContext="{Binding Updates}" x:DataType="vm:UpdateViewModel">
          <TextBlock Classes="h3" Text="Update FUPlayer" />
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Status}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Settings, Firefox sign-in and optional FFmpeg files are kept. Playback stops only when you choose Install and restart." />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Update FUPlayer" Classes="primary" Command="{Binding UpdateFuPlayerCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding !IsReady}" />
            <Button Content="Install and restart" Classes="primary" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding IsReady}" />
            <Button Content="Cancel download" Command="{Binding CancelUpdateCommand}" IsVisible="{Binding IsDownloading}" />
          </StackPanel>
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding IsDownloading}" Height="4" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <views:StreamingSettingsView DataContext="{Binding Streaming}" />
      </Border>

      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="h3" Text="Language" Margin="0,0,0,4" />
          <controls:SettingRow Title="Interface language" Description="Terms without a settled translation keep their usual name; the Glossary page under Settings explains them.">
            <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage}" Width="190" MinWidth="190" />
          </controls:SettingRow>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6,0,0" IsVisible="{Binding IsRestartNeeded}">
            <TextBlock Classes="secondary" TextWrapping="Wrap" VerticalAlignment="Center" Text="The new language is used when FUPlayer starts again." />
            <Button Grid.Column="1" Classes="primary" Command="{Binding RestartNowCommand}" Content="Restart now" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="h3" Text="Playback" Margin="0,0,0,4" />
          <controls:SettingRow Title="Gapless playback" Description="Join tracks without a pause when their processing is identical.">
            <ToggleSwitch IsChecked="{Binding Gapless}" OnContent="" OffContent="" />
          </controls:SettingRow>
          <controls:SettingRow Title="ReplayGain" Description="Level normalization from ReplayGain tags.">
            <ComboBox ItemsSource="{Binding ReplayGainChoices}" SelectedItem="{Binding SelectedReplayGain}" Width="190" MinWidth="190" />
          </controls:SettingRow>
          <controls:SettingRow Title="Prevent ReplayGain clipping" Description="Limit positive gain so the tagged peak stays below full scale.">
            <ToggleSwitch IsChecked="{Binding PreventReplayGainClipping}" OnContent="" OffContent="" />
          </controls:SettingRow>
          <controls:SettingRow Title="Invert polarity" Description="Flip the absolute phase of every channel.">
            <ToggleSwitch IsChecked="{Binding InvertPolarity}" OnContent="" OffContent="" />
          </controls:SettingRow>
          <controls:SettingRow Title="Time display">
            <ComboBox ItemsSource="{Binding TimeDisplayChoices}" SelectedItem="{Binding SelectedTimeDisplay}" Width="190" MinWidth="190" />
          </controls:SettingRow>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="h3" Text="Processing resources" Margin="0,0,0,4" />
          <controls:SettingRow Title="DSP threads" Description="{Binding SelectedDspThreads.Description}">
            <ComboBox ItemsSource="{Binding DspThreadChoices}" SelectedItem="{Binding SelectedDspThreads}" Width="190" MinWidth="190" />
          </controls:SettingRow>
          <controls:SettingRow Title="Engine FIFO" Description="{Binding SelectedFifo.Description}">
            <ComboBox ItemsSource="{Binding FifoChoices}" SelectedItem="{Binding SelectedFifo}" Width="190" MinWidth="190" />
          </controls:SettingRow>
          <TextBlock Text="{Binding FifoSize}" Classes="secondary small" TextWrapping="Wrap" Margin="0,0,0,4" />
          <controls:SettingRow Title="Preprocess files ahead" Description="Reads future samples from seekable files and compensates the filter's leading delay before output. Startup and seeking wait for that processing; filter phase and ringing stay the same. Live input keeps its full delay.">
            <ToggleSwitch IsChecked="{Binding PreprocessFiles}" OnContent="" OffContent="" />
          </controls:SettingRow>
          <controls:SettingRow Title="Meter the adjusted source" Description="Source meters and analyzer show the signal after ReplayGain and ultrasonic filtering.">
            <ToggleSwitch IsChecked="{Binding MeterAdjustedSource}" OnContent="" OffContent="" />
          </controls:SettingRow>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel IsEnabled="{Binding LocalResampling}">
          <TextBlock Classes="h3" Text="Graphics acceleration" Margin="0,0,0,4" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="CUDA is selected for NVIDIA GPUs and Vulkan for other GPUs. OpenCL remains available manually. Each filter is checked against the processor before use, and timing decides how much work to give the device." />
          <controls:SettingRow Title="Convolve on the graphics device" Description="Runs FFT or direct convolution on a CUDA, Vulkan or OpenCL device alongside the CPU. Delta-sigma modulation stays on the CPU." IsEnabled="{Binding HasGpuDevices}">
            <ToggleSwitch IsChecked="{Binding GpuAcceleration}" OnContent="" OffContent="" />
          </controls:SettingRow>
          <controls:SettingRow Title="Device" Description="{Binding SelectedGpuDevice.Description}" IsVisible="{Binding HasGpuDevices}">
            <ComboBox ItemsSource="{Binding GpuDeviceChoices}" SelectedItem="{Binding SelectedGpuDevice}" Width="230" MinWidth="230" />
          </controls:SettingRow>
          <controls:SettingRow Title="Arithmetic precision" Description="{Binding SelectedGpuPrecision.Description}" IsVisible="{Binding HasGpuDevices}">
            <ComboBox ItemsSource="{Binding GpuPrecisionChoices}" SelectedItem="{Binding SelectedGpuPrecision}" Width="230" MinWidth="230" />
          </controls:SettingRow>
          <controls:SettingRow Title="Phase division" Description="{Binding SelectedGpuDivision.Description}" IsVisible="{Binding HasGpuDevices}">
            <ComboBox ItemsSource="{Binding GpuDivisionChoices}" SelectedItem="{Binding SelectedGpuDivision}" Width="230" MinWidth="230" />
          </controls:SettingRow>
          <controls:SettingRow Title="Override the timed result" Description="Gives the device every phase even when the CPU measured faster, and accepts filters below the round-trip threshold. The output comparison still applies." IsVisible="{Binding HasGpuDevices}">
            <ToggleSwitch IsChecked="{Binding GpuForce}" OnContent="" OffContent="" />
          </controls:SettingRow>
          <TextBlock Text="{Binding GpuStatus}" Classes="secondary small" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="h3" Text="Network DSP" Margin="0,0,0,4" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Select remote stages; a stage between two selected ones runs there too. LAN servers can use plain UDP; Internet servers require an access key and use encrypted UDP. Stop releases the worker; a short Apple Music pause keeps it ready for ten seconds." />
          <controls:SettingRow Title="Process on a server" Description="Only enabled, selected stages run remotely. A compatible server can also finish DSD conversion; the DAC stays on this computer.">
            <ToggleSwitch IsChecked="{Binding NetworkDsp}" OnContent="" OffContent="" />
          </controls:SettingRow>
          <controls:SettingRow Title="Server address" Description="IP address, domain or udp://host:port URL of the processing server.">
            <TextBox Text="{Binding NetworkDspHost, UpdateSourceTrigger=LostFocus}" Width="230" MinWidth="230" />
          </controls:SettingRow>
          <controls:SettingRow Title="Server access key" Description="Paste the server's Base64 key for encrypted UDP. Leave empty only for a LAN-only server.">
            <TextBox Text="{Binding NetworkDspKey, UpdateSourceTrigger=LostFocus}" PasswordChar="●" Width="230" MinWidth="230" />
          </controls:SettingRow>
          <controls:SettingRow Title="UDP port" Description="The server listener port. Default: 58181.">
            <NumericUpDown Value="{Binding NetworkDspPort}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" Width="150" />
          </controls:SettingRow>
          <StackPanel IsEnabled="{Binding NetworkDsp}" Spacing="10" Margin="0,8,0,0">
            <CheckBox IsChecked="{Binding RemoteResampling}" Content="Resampling on server" />
            <CheckBox IsChecked="{Binding RemoteRestorer}" Content="Neural restorer on server" />
            <CheckBox IsChecked="{Binding RemoteUpscaler}" Content="Neural upscaler on server" />
            <CheckBox IsChecked="{Binding RemoteDsdOutput}" Content="DSD output conversion on server" />
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="DSD output conversion needs remote resampling and an updated server. Older servers keep this step on the client." />
            <controls:SettingRow Title="Server FIFO (ms)" Description="Audio kept ready on the server to absorb network jitter. This adds the selected delay. Requires an updated server.">
              <NumericUpDown Value="{Binding ServerFifoMilliseconds}" Minimum="100" Maximum="5000" Increment="100" FormatString="0" Width="150" />
            </controls:SettingRow>
            <controls:SettingRow Title="Server threads" Description="Total threads for this session; 0 uses the server default. The server administrator's limit always applies.">
              <NumericUpDown Value="{Binding ServerThreads}" Minimum="0" Maximum="64" Increment="1" FormatString="0" Width="150" />
            </controls:SettingRow>
            <CheckBox IsChecked="{Binding ServerGpu}" Content="Allow server GPU filtering" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
              <TextBlock Classes="h3" Text="FFmpeg" />
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="MP3, AAC, ALAC, Ogg Vorbis, Opus, WavPack, Monkey's Audio, WMA and the rest play through FFmpeg, an LGPL library the player loads when it finds it. It is kept apart from the player, so any build of the same version can stand in for it." />
            </StackPanel>
            <Border Grid.Column="1" Classes="badge" Classes.accent="{Binding IsFfmpegAvailable}" VerticalAlignment="Top">
              <TextBlock Text="{Binding FfmpegBadge}" />
            </Border>
          </Grid>
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding FfmpegStatus}" />

          <StackPanel Spacing="10" IsVisible="{Binding CanBuildFfmpeg}">
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding FfmpegBuildDescription}" />
            <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding BuildFfmpegCommand}" Content="Download and build FFmpeg" />
          </StackPanel>

          <StackPanel Spacing="7" IsVisible="{Binding IsFfmpegBuilding}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{Binding FfmpegStage}" FontWeight="Medium" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="subtle" Command="{Binding CancelFfmpegBuildCommand}" Content="Stop" />
            </Grid>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding FfmpegProgress}" IsIndeterminate="{Binding !IsFfmpegProgressKnown}"
                         MinWidth="0" MinHeight="4" Height="4" />
            <TextBlock Classes="muted small" Text="{Binding FfmpegLine}" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding HasFfmpegError}">
            <TextBlock Classes="danger small" TextWrapping="Wrap" Text="{Binding FfmpegError}" />
            <Button Classes="subtle" HorizontalAlignment="Left" Command="{Binding OpenFfmpegLogCommand}" Content="Open the build log" />
          </StackPanel>
          <TextBlock Classes="accent small" TextWrapping="Wrap" IsVisible="{Binding HasFfmpegDone}" Text="{Binding FfmpegDone}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h3" Text="About FUPlayer" />
          <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Text="Version" Classes="muted" Margin="0,4" />
            <TextBlock Grid.Column="1" Text="{Binding Version}" Margin="0,4" />
            <TextBlock Grid.Row="1" Text="License" Classes="muted" Margin="0,4" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="MIT for FUPlayer itself  ·  LGPL-2.1 for TagLib# and the optional FFmpeg libraries" Classes="secondary" TextWrapping="Wrap" Margin="0,4" />
            <TextBlock Grid.Row="2" Text="Runtime" Classes="muted" Margin="0,4" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeDescription}" Classes="secondary" TextWrapping="Wrap" Margin="0,4" />
            <TextBlock Grid.Row="3" Text="FFmpeg (LGPL)" Classes="muted" Margin="0,4" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FfmpegStatus}" Classes="secondary" Classes.accent="{Binding IsFfmpegAvailable}" TextWrapping="Wrap" Margin="0,4" />
            <TextBlock Grid.Row="4" Text="Settings folder" Classes="muted" Margin="0,4" VerticalAlignment="Center" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,4">
              <TextBlock Text="{Binding SettingsFolder}" Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
              <Button Classes="subtle" Content="Open" Command="{Binding OpenSettingsFolderCommand}" />
            </StackPanel>
          </Grid>
          <Border Classes="divider" Margin="0,4" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="FUPlayer is free software released under the MIT License. It uses Avalonia (MIT), CommunityToolkit.Mvvm (MIT), TagLib# (LGPL-2.1) and, when present, FFmpeg libraries built under the LGPL; the LGPL parts stay separate, replaceable libraries. See LICENSE and THIRD-PARTY-NOTICES.md for details." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
