<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FUPlayer.App.ViewModels"
             xmlns:controls="using:FUPlayer.App.Controls"
             x:Class="FUPlayer.App.Views.StreamingView"
             x:DataType="vm:StreamingViewModel">
  <Grid Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
    <controls:FirefoxHost Session="{Binding Browser}" />
    <Border IsVisible="{Binding !IsReady}" Background="{StaticResource SurfaceBrush}">
      <TextBlock Text="{Binding Status}" Classes="secondary" TextWrapping="Wrap"
                 MaxWidth="480" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</UserControl>
