<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FUPlayer.App.ViewModels"
             xmlns:controls="using:FUPlayer.App.Controls"
             x:Class="FUPlayer.App.Views.GlossaryView"
             x:DataType="vm:GlossaryViewModel">
  <ScrollViewer Classes="page">
    <StackPanel Margin="28,22,28,28" Spacing="18" MaxWidth="1000" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Glossary" />
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="Plain explanations of the terms FUPlayer uses. Most settings can be left as they are; this page is for when you want to know what one means." />
      </StackPanel>

      <Grid ColumnDefinitions="Auto,*" Width="420" HorizontalAlignment="Left">
        <controls:LineIcon Data="{x:Static controls:Icons.Search}" Width="16" Height="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
        <TextBox Grid.Column="1" Text="{Binding SearchText}" PlaceholderText="Search the terms" />
      </Grid>

      <TextBlock Classes="secondary" Text="No term matches the search." IsVisible="{Binding !HasResults}" />

      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="18" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GlossaryGroup">
            <Border Classes="card">
              <StackPanel Spacing="14">
                <TextBlock Classes="h3" Text="{Binding Title}" />
                <ItemsControl ItemsSource="{Binding Entries}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="14" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GlossaryEntry">
                      <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Term}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Original}" Classes="muted small" VerticalAlignment="Bottom" IsVisible="{Binding HasOriginal}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Explanation}" Classes="secondary" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
