<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FUPlayer.App.ViewModels"
             xmlns:controls="using:FUPlayer.App.Controls"
             x:Class="FUPlayer.App.Views.LiveInputView"
             x:DataType="vm:LiveInputViewModel">
  <ScrollViewer Classes="page">
    <StackPanel Margin="28,22,28,28" Spacing="18" MaxWidth="1000" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Live input" />
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="Take audio from a running application and send it through the processing chain to the output device. The stream is what the application renders, after the session mixer, at the rate Windows mixes at." />
      </StackPanel>

      <Border Classes="card" IsVisible="{Binding IsUnsupported}">
        <Grid ColumnDefinitions="Auto,*">
          <controls:LineIcon Data="{x:Static controls:Icons.Warning}" Width="18" Height="18" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <TextBlock Grid.Column="1" Classes="secondary" TextWrapping="Wrap" Text="{Binding UnsupportedReason}" />
        </Grid>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsSupported}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Classes="h3" Text="Applications" />
              <TextBlock Classes="muted small" Text="Every application holding an audio session. The list refreshes while this page is open." />
            </StackPanel>
            <Button Grid.Column="1" Classes="subtle" Command="{Binding RefreshCommand}" Content="Refresh" VerticalAlignment="Center" />
          </Grid>

          <TextBlock Classes="muted" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap"
                     Text="Nothing holds an audio session. Start playback in the application you want to capture, then refresh." />

          <ItemsControl ItemsSource="{Binding Applications}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CaptureTargetViewModel">
                <Border Classes="inset" Margin="0,3" Padding="12,10">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" Classes="muted small" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="badge" Classes.accent="{Binding IsCaptured}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding State}" />
                    </Border>
                    <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:LiveInputViewModel)DataContext).StartCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:LineIcon Data="{x:Static controls:Icons.Play}" IsFilled="True" Width="13" Height="13" />
                        <TextBlock Text="Capture" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsCapturing}">
            <Border Classes="badge accent">
              <TextBlock Text="CAPTURING" />
            </Border>
            <TextBlock Text="{Binding CapturingLabel}" VerticalAlignment="Center" FontWeight="Medium" />
            <Button Classes="subtle" Command="{Binding StopCommand}" Content="Stop" />
          </StackPanel>
          <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasCaptureNote}" Text="{Binding CaptureNote}" />

          <Border Classes="divider" Margin="0,4" />
          <controls:SettingRow Title="Mute the application's own playback"
                               Description="Mutes the devices it plays to while captured, so it is heard once. The player's own output is never muted; everything is unmuted when the capture stops.">
            <ToggleSwitch IsChecked="{Binding SilenceCapturedApplication}" OnContent="" OffContent="" />
          </controls:SettingRow>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsSupported}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h3" Text="What to expect" />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="A long filter delays the audio. At 2,097,152 taps and 705.6 kHz the group delay alone is 1.5 seconds, which is inaudible for music and hopeless against a picture. Use a short filter for video, or accept that the sound arrives late." />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="Set the captured application's own volume to full and use this player's volume instead, so nothing is attenuated before the filtering." />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="Do not mute the application in the Windows volume mixer: that silences the capture too. Muting its playback device, which the setting above does, leaves the capture intact." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
